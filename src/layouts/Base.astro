---
import { Font } from 'astro:assets';
import isotypeBlack from '../assets/brand/isotypeBlack.svg';
import isotypeWhite from '../assets/brand/isotypeWhite.svg';
import tokens from '../../tokens/tokens.json';
import '../styles/global.css';

/** A primitive's literal value from the token source: the one place colors are written. */
function tokenValue(name: string): string {
  for (const group of Object.values(tokens.primitive)) {
    const token = (group as Record<string, { $value?: string }>)[name];
    if (token?.$value) return token.$value;
  }
  throw new Error(`Unknown primitive token: ${name}`);
}

interface Props {
  title: string;
  description: string;
  /** The experiment arms this document was rendered for, as the analytics context carries them. */
  experiments?: string;
  /** False for pages that are never a search result, whatever the indexing flag says. */
  indexable?: boolean;
}

const { title, description, experiments, indexable = true } = Astro.props;
// Every arm is the same page to a search engine: the one at the site root.
const canonical = new URL('/', Astro.site);

// The demo carries someone else's brand, so it stays out of search unless
// indexing is switched on at build time (ADR 0009).
const allowIndexing = indexable && import.meta.env.ALLOW_INDEXING === 'true';

// The share image is generated by `npm run gen:og` from the tokens and the kit's logo.
const socialImage = new URL('/og.png', Astro.site);
// The ground color for the browser's own interface. A <meta> cannot read a CSS variable,
// so the value is the kit's dark-900, and `npm run check:kit` holds tokens.json to the kit.
const THEME_COLOR = tokenValue('dark-900');
---

<!doctype html>
<html lang="en" data-experiments={experiments}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {/* The isotype is the kit's mark for square contexts. Both files are used as shipped:
        the white one where the browser's own interface is dark, the black one where it is light. */}
    <link
      rel="icon"
      type="image/svg+xml"
      href={isotypeWhite.src}
      media="(prefers-color-scheme: dark)"
    />
    <link
      rel="icon"
      type="image/svg+xml"
      href={isotypeBlack.src}
      media="(prefers-color-scheme: light)"
    />
    {!allowIndexing && <meta name="robots" content="noindex, nofollow" />}
    <meta name="theme-color" content={THEME_COLOR} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Try FX Replay Free (candidate demo)" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta
      property="og:image:alt"
      content="Test your strategy before you trust it. Try FX Replay free."
    />
    <meta name="twitter:card" content="summary_large_image" />
    <slot name="head" />
    {/* Only the headline face is preloaded: it paints the largest text on the page. */}
    <Font cssVariable="--font-display" preload={[{ weight: 900 }]} />
    <Font cssVariable="--font-body" />
  </head>
  <body>
    <slot />
  </body>
</html>
