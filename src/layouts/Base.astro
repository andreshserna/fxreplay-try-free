---
import { Font } from 'astro:assets';
import isotypeBlack from '../assets/brand/isotypeBlack.svg';
import isotypeWhite from '../assets/brand/isotypeWhite.svg';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  /** The experiment arms this document was rendered for, as the analytics context carries them. */
  experiments?: string;
  /** False for pages that are never a search result, whatever the indexing flag says. */
  indexable?: boolean;
}

const { title, description, experiments, indexable = true } = Astro.props;
// Every arm is the same page to a search engine: the one at the site root.
const canonical = new URL('/', Astro.site);

// The demo carries someone else's brand, so it stays out of search unless
// indexing is switched on at build time (ADR 0009).
const allowIndexing = indexable && import.meta.env.ALLOW_INDEXING === 'true';
---

<!doctype html>
<html lang="en" data-experiments={experiments}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {/* The isotype is the kit's mark for square contexts. Both files are used as shipped:
        the white one where the browser's own interface is dark, the black one where it is light. */}
    <link
      rel="icon"
      type="image/svg+xml"
      href={isotypeWhite.src}
      media="(prefers-color-scheme: dark)"
    />
    <link
      rel="icon"
      type="image/svg+xml"
      href={isotypeBlack.src}
      media="(prefers-color-scheme: light)"
    />
    {!allowIndexing && <meta name="robots" content="noindex, nofollow" />}
    {/* Only the headline face is preloaded: it paints the largest text on the page. */}
    <Font cssVariable="--font-display" preload={[{ weight: 900 }]} />
    <Font cssVariable="--font-body" />
  </head>
  <body>
    <slot />
  </body>
</html>
