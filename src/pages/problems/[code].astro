---
import wordmark from '../../assets/brand/FXReplayLogo.svg';
import { PROBLEMS, type ProblemCode } from '../../lib/api/problems';
import Base from '../../layouts/Base.astro';

/**
 * One static page per problem type. They make the `type` URI of every error response
 * resolve to something a person can read (RFC 9457), from the same registry the API uses.
 */
export function getStaticPaths() {
  return (Object.keys(PROBLEMS) as ProblemCode[]).map((code) => ({
    params: { code: code.replaceAll('_', '-') },
    props: { code },
  }));
}

interface Props {
  code: ProblemCode;
}

const { code } = Astro.props;
const { status, title, when } = PROBLEMS[code];
---

<Base
  title={`${title} (${status})`}
  description={`The ${code} problem type of the Users API.`}
  indexable={false}
>
  <main class="problem">
    <a class="home" href="/" aria-label="FX Replay, candidate demo: the page">
      <img src={wordmark.src} width={wordmark.width} height={wordmark.height} alt="FX Replay" />
    </a>
    <p class="kind">Users API problem type</p>
    <h1>{title}</h1>
    <p>{when}</p>
    <dl>
      <dt>Status</dt>
      <dd>{status}</dd>
      <dt>Code</dt>
      <dd>
        <code>{code}</code>
      </dd>
    </dl>
    <p>
      Error responses from the Users API are <code>application/problem+json</code> documents.
      Clients switch on <code>code</code>. The text of <code>title</code> and <code>detail</code> is
      for people and may change.
    </p>
    <p class="notice">Candidate challenge demo. Not the official FX Replay site.</p>
  </main>
</Base>

<style>
  .problem {
    display: grid;
    gap: var(--space-5);
    max-width: 40rem;
    margin-inline: auto;
    padding: var(--space-7) var(--gutter);
  }

  .home {
    justify-self: start;
    border-radius: 0.25rem;
  }

  img {
    width: min(11rem, 60vw);
    height: auto;
  }

  .kind,
  .notice {
    color: var(--text-secondary);
    font-size: var(--step--1);
  }

  h1 {
    font-size: var(--step-3);
  }

  /* A code is set apart by weight, in the body family: the page has two families, not three. */
  code {
    font-family: inherit;
    font-weight: 700;
  }

  dl {
    display: grid;
    grid-template-columns: max-content 1fr;
    gap: var(--space-2) var(--space-5);
    margin: 0;
    padding: var(--space-4) var(--space-5);
    border: 1px solid var(--border-primary);
    border-radius: var(--radius-surface);
    background: var(--bg-secondary);
  }

  dt {
    color: var(--text-secondary);
  }

  dd {
    margin: 0;
  }

  .notice {
    padding-top: var(--space-5);
    border-top: 1px solid var(--border-primary);
  }
</style>
