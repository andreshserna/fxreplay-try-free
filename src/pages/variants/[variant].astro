---
/**
 * The landing page, prerendered once per arm of the hero experiment. Visitors never
 * request these paths: the edge serves the right one at "/" (src/server/landing.ts).
 *
 * Each section answers one objection that stands between a visitor and the signup:
 * what is it, can I believe it, how does it work, is it for me, what is the catch,
 * what else should I know.
 */
import type { GetStaticPaths } from 'astro';

import Audience from '../../components/landing/Audience.astro';
import Closing from '../../components/landing/Closing.astro';
import { QUESTIONS } from '../../components/landing/faq';
import Faq from '../../components/landing/Faq.astro';
import FreePlan from '../../components/landing/FreePlan.astro';
import Hero from '../../components/landing/Hero.astro';
import HowItWorks from '../../components/landing/HowItWorks.astro';
import SiteFooter from '../../components/landing/SiteFooter.astro';
import SiteHeader from '../../components/landing/SiteHeader.astro';
import StatsBar from '../../components/landing/StatsBar.astro';
import Base from '../../layouts/Base.astro';
import { EXPERIMENTS, formatAssignments, type VariantOf } from '../../lib/experiments/registry';

export const getStaticPaths = (() =>
  EXPERIMENTS.hero_signup.variants.map((variant) => ({
    params: { variant },
  }))) satisfies GetStaticPaths;

const variant = Astro.params.variant as VariantOf<'hero_signup'>;

// Short enough to show whole in a search result, with the disclaimer where it is not cut.
const TITLE = 'Try FX Replay Free (candidate demo)';
const DESCRIPTION =
  'Candidate demo, not the official FX Replay site. Replay real market history candle by candle and practise your strategy with simulated trades. Free plan.';

// What the page is, for a search engine: one page about FX Replay that answers questions.
// It claims no publisher: this is a demo, and it does not speak for the company.
const url = new URL('/', Astro.site).href;
const structuredData = {
  '@context': 'https://schema.org',
  '@type': ['WebPage', 'FAQPage'],
  '@id': `${url}#page`,
  url,
  name: TITLE,
  description: DESCRIPTION,
  inLanguage: 'en',
  about: { '@type': 'Thing', name: 'FX Replay', url: 'https://fxreplay.com/' },
  mainEntity: QUESTIONS.map((item) => ({
    '@type': 'Question',
    name: item.q,
    acceptedAnswer: { '@type': 'Answer', text: item.a },
  })),
};

// Switched off, everyone sees the control and no event names an arm.
const running = EXPERIMENTS.hero_signup.enabled
  ? { experiments: formatAssignments({ hero_signup: variant }) }
  : {};
---

<Base {...running} title={TITLE} description={DESCRIPTION}>
  <script
    slot="head"
    type="application/ld+json"
    is:inline
    set:html={JSON.stringify(structuredData).replaceAll('<', '\\u003c')}
  />
  <a class="skip" href="#signup">
    Skip to sign up
  </a>
  <SiteHeader />
  <main>
    <Hero variant={variant} />
    <StatsBar />
    <HowItWorks />
    <Audience />
    <FreePlan />
    <Faq />
    <Closing />
  </main>
  <SiteFooter />
</Base>

<script>
  // Not an island: a few lines that report the page view, clicks on calls to action and
  // field performance. They load after the page and can fail without affecting it.
  import type { EventProperties } from '../../lib/analytics/registry';
  import { track } from '../../lib/analytics/track';
  import { reportWebVitals } from '../../lib/analytics/vitals';

  // A type-only import: the registry's text stays out of the page's script.
  type CtaLocation = EventProperties<'cta_clicked'>['cta_location'];
  const locations = ['header', 'hero', 'plan'] as const satisfies CtaLocation[];
  const isLocation = (value: string | undefined): value is CtaLocation =>
    (locations as readonly (string | undefined)[]).includes(value);

  // A browser may render the page ahead of a visit. The view counts when it is shown,
  // which is also when the edge would have counted the exposure.
  const prerendering = (document as Document & { prerendering?: boolean }).prerendering;
  if (prerendering) {
    document.addEventListener('prerenderingchange', () => track('landing_viewed'), { once: true });
  } else {
    track('landing_viewed');
  }
  reportWebVitals();

  // A double click is one intent: repeats on the same call to action within a second
  // count once.
  const lastClick = new Map<CtaLocation, number>();
  const still = window.matchMedia('(prefers-reduced-motion: reduce)');

  document.addEventListener('click', (event) => {
    const target = event.target instanceof Element ? event.target.closest('[data-cta]') : null;
    const location = target instanceof HTMLElement ? target.dataset.cta : undefined;
    if (!isLocation(location)) return;
    const now = performance.now();
    if (now - (lastClick.get(location) ?? -Infinity) >= 1000) {
      track('cta_clicked', { cta_name: 'start_free', cta_location: location });
    }
    lastClick.set(location, now);
    // Without this script the link is the browser's own anchor and cuts to the form. With
    // it the page travels there. The easing is asked for here, for this one journey, and
    // not in the stylesheet, where it would also slow every move of keyboard focus.
    const form = document.getElementById('signup');
    if (form) {
      event.preventDefault();
      form.scrollIntoView({ behavior: still.matches ? 'auto' : 'smooth', block: 'start' });
      history.replaceState(null, '', '#signup');
    }
    // Once the page has arrived, put the cursor in the field too, so one tap is enough.
    // Focusing earlier would raise a phone's keyboard mid-way.
    const field = document.querySelector<HTMLInputElement>('#signup input[type="email"]');
    if (!field) return;
    let arrived = false;
    const focus = () => {
      if (arrived) return;
      arrived = true;
      field.focus({ preventScroll: true });
    };
    document.addEventListener('scrollend', focus, { once: true });
    // For a browser without `scrollend`, and for a form that was already in view.
    window.setTimeout(focus, 1200);
  });
</script>
