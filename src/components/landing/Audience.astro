---
/** Who it is for, in the three situations FX Replay's own help center names. */
const people = [
  {
    who: 'You are new to trading',
    what: 'Learn to read a chart and build a first strategy on days that have already happened.',
  },
  {
    who: 'You already trade',
    what: 'Test and refine a strategy before you trade it live. Find out whether it was the rules or the week.',
  },
  {
    who: 'You are preparing for a prop firm challenge',
    what: 'Practise your rules on market history first, where a mistake costs nothing.',
  },
];
---

<section class="shell audience" data-section="audience" aria-labelledby="audience-heading">
  <h2 id="audience-heading">Wherever you are with your strategy.</h2>
  <ul>
    {people.map((person) => (
      <li>
        <h3>{person.who}</h3>
        <p>{person.what}</p>
      </li>
    ))}
  </ul>
</section>

<style>
  .audience {
    display: grid;
    gap: var(--space-6);
    padding-block: var(--section);
    border-top: 1px solid var(--border-primary);
  }

  h2 {
    max-width: 22ch;
    font-size: var(--step-3);
  }

  ul {
    display: grid;
    align-content: start;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  li {
    display: grid;
    gap: var(--space-2);
    padding-block: var(--space-5);
    border-top: 1px solid var(--border-primary);
  }

  li:last-child {
    border-bottom: 1px solid var(--border-primary);
  }

  @media (width >= 62rem) {
    .audience {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      gap: var(--space-8);
    }
  }

  h3 {
    font-size: var(--step-2);
  }

  li p {
    color: var(--text-secondary);
    font-size: var(--step-1);
    line-height: 1.5;
  }
</style>
