---
/**
 * Three figures, each read on fxreplay.com (docs/research/brief.md, section 2). The
 * first is FX Replay's own claim and is worded as theirs. The second is a count of
 * their Markets page. The third counts from the year their EUR/USD history starts.
 * None is a result a trader can expect.
 *
 * Set as a line of proof, lighter than the headline: in this category a stats row is
 * common, and it is never the loudest thing on the page (docs/research/visual-patterns.md).
 */
const figures = [
  { value: '1M+', label: 'traders have used FX Replay, by its own count' },
  { value: '173', label: 'markets to replay on the free plan' },
  { value: '23 years', label: 'of EUR/USD history, back to 2003' },
];
---

<section class="shell stats" data-section="figures" aria-label="FX Replay in three figures">
  <dl>
    {figures.map((figure) => (
      <div>
        <dt>{figure.label}</dt>
        <dd>{figure.value}</dd>
      </div>
    ))}
  </dl>
  <p>Figures from fxreplay.com, read on 18 November 2026.</p>
</section>

<style>
  .stats {
    display: grid;
    gap: var(--space-4);
    padding-block: var(--space-5);
    border-top: 1px solid var(--border-primary);
  }

  dl {
    display: grid;
    gap: var(--space-3);
    margin: 0;
  }

  @media (width >= 62rem) {
    dl {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: var(--space-6);
    }
  }

  /* The figure leads its sentence. The markup keeps the term before its value. */
  dl div {
    display: flex;
    flex-direction: row-reverse;
    justify-content: flex-end;
    align-items: baseline;
    gap: var(--space-3);
  }

  dd {
    flex: none;
    margin: 0;
    /* The body family at a weight the page already loads: a display weight used only
       here would be one more font file for three numbers. */
    font-size: var(--step-2);
    font-weight: 700;
    line-height: 1.2;
    letter-spacing: -0.01em;
  }

  dt {
    color: var(--text-secondary);
    line-height: 1.4;
  }

  p {
    color: var(--text-secondary);
  }
</style>
