---
/**
 * The hero. Its last element is what the first experiment changes: a button that leads
 * to the form (the control) or the email field itself (the variant). Everything else
 * is identical in both arms.
 */
import type { VariantOf } from '../../lib/experiments/registry';
import Signup from '../signup/Signup.astro';
import ReplayChart from './ReplayChart.astro';

interface Props {
  variant: VariantOf<'hero_signup'>;
}

const { variant } = Astro.props;
const promises = ['Free plan', 'No credit card', 'No time limit'];
---

<section class="hero">
  <div class="pitch">
    <p class="kicker">Try FX Replay free</p>
    <h1>Test your strategy before you trust it.</h1>
    <p class="lede">
      Replay real market history candle by candle, place simulated trades and review what your rules
      did. In your browser, with no money at risk.
    </p>
    <div class="action">
      {variant === 'inline_email' ? (
        <Signup location="hero" cta="Start for free" promises={promises} />
      ) : (
        <>
          <a class="button" href="#signup" data-cta="hero">
            Start for free
          </a>
          <ul class="promises">
            {promises.map((promise) => (
              <li>{promise}</li>
            ))}
          </ul>
        </>
      )}
    </div>
  </div>
  <div class="stage">
    <ReplayChart />
  </div>
</section>

<style>
  /* The page grid, opened up so the stage can run off the right edge. */
  .hero {
    display: grid;
    grid-template-columns:
      [full-start] minmax(var(--gutter), 1fr)
      [content-start] minmax(0, var(--measure))
      [content-end] minmax(var(--gutter), 1fr) [full-end];
    row-gap: var(--space-7);
    padding-block: var(--space-5) var(--space-7);
  }

  .pitch,
  .stage {
    grid-column: content;
  }

  .pitch {
    display: grid;
    align-content: center;
    gap: var(--space-5);
  }

  h1 {
    font-size: var(--step-4);
    line-height: 1.02;
    letter-spacing: -0.03em;
  }

  .lede {
    max-width: 34rem;
    color: var(--text-secondary);
    font-size: var(--step-1);
    line-height: 1.5;
  }

  .action {
    display: grid;
    gap: var(--space-3);
    max-width: 32rem;
    margin-top: var(--space-2);
  }

  .action :global(.button) {
    justify-self: start;
    min-width: 12rem;
  }

  @media (width < 30rem) {
    .action :global(.button) {
      justify-self: stretch;
    }
  }

  /* Once the account exists, the promises that asked for it have done their job. */
  .action:has(:global(.signup-after)) :global(.promises) {
    display: none;
  }

  @media (width >= 62rem) {
    .hero {
      grid-template-columns:
        [full-start] minmax(var(--gutter), 1fr)
        [content-start] minmax(0, calc(var(--measure) * 0.47))
        [stage-start] minmax(0, calc(var(--measure) * 0.53))
        [content-end] minmax(var(--gutter), 1fr) [full-end];
      align-items: center;
      padding-block: var(--space-6) var(--space-8);
    }

    .pitch {
      grid-column: content-start / stage-start;
      padding-right: var(--space-6);
    }

    /* Pinned to the top of its row: when the form grows into the profile step, the
       illustration stays beside the headline instead of sliding down. */
    .stage {
      position: sticky;
      top: var(--space-6);
      grid-column: stage-start / full-end;
      align-self: start;
    }

    /* The chart runs off the edge of the screen. Its controls do not: they end where the
       page's content ends. */
    .stage :global(.replay) {
      --replay-bleed: max(var(--gutter), calc((100vw - var(--measure)) / 2));

      border-right: 0;
      border-radius: var(--radius-surface) 0 0 var(--radius-surface);
    }
  }
</style>
