---
/**
 * The free plan with its limits stated. Every line traces to fxreplay.com
 * (docs/research/brief.md, section 3.1). No price is printed: prices there vary by
 * country, and "free" is the only one every visitor sees the same.
 */
const included = [
  ['2', 'Backtesting sessions'],
  ['50', 'Trades per session'],
  ['1 month', 'Market history per session'],
  ['1', 'Indicator, on one chart'],
];

const also = [
  'Forex, indices, metals and part of the crypto list',
  'A journal of every simulated trade',
  'Sessions older than a week are hidden from your list, not deleted',
];

const notIncluded = ['Futures and CME data', 'Seconds data', 'Several charts at once', 'Rewind'];
---

<section class="shell plan" aria-labelledby="plan-heading">
  <div class="intro">
    <p class="kicker">The free plan, in full</p>
    <h2 id="plan-heading">Free means free. Here is exactly what you get.</h2>
    <p class="lede">
      No credit card, no trial period, and nothing that converts to a paid plan. The limits are
      real, so here they are.
    </p>
  </div>

  <div class="card">
    <dl class="numbers">
      {included.map(([value, label]) => (
        <div>
          <dt>{label}</dt>
          <dd>{value}</dd>
        </div>
      ))}
    </dl>
    <div class="lists">
      <div>
        <h3>Also on the free plan</h3>
        <ul>
          {also.map((item) => (
            <li>{item}</li>
          ))}
        </ul>
      </div>
      <div>
        <h3>On paid plans only</h3>
        <ul class="without">
          {notIncluded.map((item) => (
            <li>{item}</li>
          ))}
        </ul>
      </div>
    </div>
  </div>
</section>

<style>
  .plan {
    display: grid;
    gap: var(--space-6);
    padding-block: var(--section);
    border-top: 1px solid var(--border-primary);
  }

  .intro {
    display: grid;
    gap: var(--space-4);
  }

  h2 {
    max-width: 18ch;
    font-size: var(--step-3);
  }

  .lede {
    max-width: 34rem;
    color: var(--text-secondary);
    font-size: var(--step-1);
    line-height: 1.5;
  }

  @media (width >= 62rem) {
    .plan {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      gap: var(--space-8);
      align-items: start;
    }
  }

  .card {
    display: grid;
    gap: var(--space-5);
    padding: clamp(1.25rem, 0.9rem + 1.6vw, 2.25rem);
    border: 1px solid var(--border-secondary);
    border-radius: 1rem;
    background:
      radial-gradient(
        120% 90% at 100% 0%,
        color-mix(in srgb, var(--chart-up) 18%, transparent),
        transparent 60%
      ),
      var(--bg-secondary);
  }

  .numbers {
    display: grid;
    margin: 0;
  }

  .numbers div {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-4);
    padding-block: var(--space-3);
    border-bottom: 1px solid var(--border-secondary);
  }

  .numbers dt {
    color: var(--text-secondary);
  }

  .numbers dd {
    margin: 0;
    font-family: var(--font-display);
    font-size: var(--step-2);
    font-weight: 900;
    line-height: 1;
    letter-spacing: -0.02em;
    white-space: nowrap;
  }

  .lists {
    display: grid;
    gap: var(--space-5);
  }

  @media (width >= 40rem) {
    .lists {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  h3 {
    font-family: var(--font-body);
    font-size: var(--step--1);
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  ul {
    display: grid;
    gap: var(--space-2);
    margin: var(--space-3) 0 0;
    padding: 0;
    color: var(--text-secondary);
    list-style: none;
  }

  li {
    display: grid;
    grid-template-columns: 1rem 1fr;
    gap: var(--space-2);
  }

  li::before {
    content: '';
    width: 0.5rem;
    height: 0.5rem;
    margin-top: 0.55em;
    border-radius: 50%;
    background: var(--chart-up);
  }

  .without li::before {
    height: 2px;
    margin-top: 0.75em;
    border-radius: 0;
    background: var(--icon-secondary);
  }
</style>
