---
import { QUESTIONS } from './faq';

/** The objections left after the page. The text lives in faq.ts. */
---

<section class="shell faq" data-section="faq" aria-labelledby="faq-heading">
  <h2 id="faq-heading">Fair questions.</h2>
  <div class="list">
    {QUESTIONS.map((item) => (
      <details>
        <summary>{item.q}</summary>
        <p>{item.a}</p>
      </details>
    ))}
  </div>
</section>

<style>
  .faq {
    display: grid;
    gap: var(--space-6);
    padding-block: var(--section);
    border-top: 1px solid var(--border-primary);
  }

  @media (width >= 62rem) {
    .faq {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      gap: var(--space-8);
    }
  }

  h2 {
    font-size: var(--step-3);
  }

  details {
    border-bottom: 1px solid var(--border-secondary);
  }

  details:first-child {
    border-top: 1px solid var(--border-secondary);
  }

  summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    min-height: var(--control-height);
    padding-block: var(--space-3);
    font-size: var(--step-1);
    font-weight: 700;
    cursor: pointer;
    list-style: none;
  }

  summary:focus-visible {
    outline-offset: 4px;
    border-radius: var(--radius-control);
  }

  @media (hover: hover) {
    summary:hover {
      color: var(--text-link);
    }
  }

  summary::-webkit-details-marker {
    display: none;
  }

  /* A plus that becomes a minus: the upright bar shrinks away as the mark turns. */
  summary::after {
    content: '';
    flex: none;
    width: 0.875rem;
    height: 0.875rem;
    background:
      linear-gradient(var(--icon-primary), var(--icon-primary)) center / 100% 2px no-repeat,
      linear-gradient(var(--icon-primary), var(--icon-primary)) center / 2px 100% no-repeat;
    transition:
      transform 0.3s ease,
      background-size 0.3s ease;
  }

  details[open] summary::after {
    background-size:
      100% 2px,
      2px 0;
    transform: rotate(180deg);
  }

  details p {
    max-width: 40rem;
    padding-bottom: var(--space-5);
    color: var(--text-secondary);
  }

  /* The answer opens and closes by growing, not by appearing. `interpolate-size` lets the
     height run to and from `auto`. A browser without it opens the answer at once and
     fades it in, below. */
  .list {
    interpolate-size: allow-keywords;
  }

  details::details-content {
    block-size: 0;
    overflow: clip;
    opacity: 0;
    transition:
      block-size 0.3s ease,
      opacity 0.3s ease,
      content-visibility 0.3s allow-discrete;
  }

  details[open]::details-content {
    block-size: auto;
    opacity: 1;
  }

  @supports not (interpolate-size: allow-keywords) {
    details::details-content {
      block-size: auto;
    }

    details[open] p {
      animation: reveal 0.3s ease;
    }
  }

  @keyframes reveal {
    from {
      opacity: 0;
      transform: translateY(-0.25rem);
    }
  }
</style>
