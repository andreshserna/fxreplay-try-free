---
import wordmark from '../../assets/brand/FXReplayLogo.svg';
---

<header class="shell site-header">
  <a href="/" aria-label="FX Replay, candidate demo: top of the page">
    <img src={wordmark.src} width={wordmark.width} height={wordmark.height} alt="FX Replay" />
  </a>
  <p>
    <span class="narrow">Candidate demo</span>
    <span class="wide">Candidate challenge demo. Not the official FX Replay site</span>
  </p>
</header>

<style>
  .site-header {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    padding-block: var(--space-5);
  }

  a {
    display: block;
    border-radius: 0.25rem;
  }

  /* The wordmark as shipped: scaled as a whole, never recolored. */
  img {
    width: auto;
    height: 1.375rem;
  }

  p {
    color: var(--text-secondary);
    font-size: var(--step--1);
    line-height: 1.3;
    text-align: right;
    white-space: nowrap;
  }

  @media (width < 48rem) {
    .wide {
      display: none;
    }
  }

  @media (width >= 48rem) {
    .narrow {
      display: none;
    }
  }
</style>
