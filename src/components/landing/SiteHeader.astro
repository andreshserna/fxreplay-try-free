---
import wordmark from '../../assets/brand/FXReplayLogo.svg';

/**
 * Stays at the top of the screen, so the call to action is one tap away from anywhere on
 * the page. It is an outline button: the filled one belongs to the hero and the form.
 */
---

<header class="site-header">
  <div class="shell bar">
    <a class="home" href="#top" aria-label="FX Replay: top of the page">
      <img src={wordmark.src} width={wordmark.width} height={wordmark.height} alt="FX Replay" />
    </a>
    <a class="cta" href="#signup" data-cta="header">
      Start for free
    </a>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 10;
    border-bottom: 1px solid var(--border-primary);
    background: color-mix(in srgb, var(--bg-primary) 92%, transparent);
    backdrop-filter: blur(12px);
  }

  /* The wordmark at one end and the call to action at the other. What the page is, a
     candidate's demo, is said where it is read: in the FAQ and in the footer. */
  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    min-height: var(--header-height);
  }

  /* A target as tall as the button beside it, around a wordmark that is not. */
  .home {
    display: flex;
    flex: none;
    align-items: center;
    min-height: 2.75rem;
    border-radius: 0.25rem;
  }

  /* The wordmark as shipped: scaled as a whole, never recolored. */
  img {
    width: auto;
    height: 1.125rem;
  }

  .cta {
    display: inline-flex;
    flex: none;
    align-items: center;
    min-height: 2.75rem;
    padding-inline: var(--space-4);
    border: 1px solid var(--border-field);
    border-radius: var(--radius-control);
    color: var(--text-primary);
    font-weight: 700;
    text-decoration: none;
    white-space: nowrap;
    transition:
      border-color 0.15s ease,
      background-color 0.15s ease;
  }

  @media (hover: hover) {
    .cta:hover {
      border-color: var(--icon-primary);
      background: var(--bg-tertiary);
    }
  }

  /* A tap gets an answer too: a phone has no hover. */
  .cta:active {
    border-color: var(--icon-primary);
    background: var(--bg-tertiary);
  }

  /* The narrowest phones: a smaller wordmark and a tighter button, so the two always fit. */
  @media (width < 24rem) {
    img {
      height: 1rem;
    }

    .cta {
      padding-inline: var(--space-3);
    }
  }

  @media (width >= 48rem) {
    img {
      height: 1.375rem;
    }
  }
</style>
