---
import wordmark from '../../assets/brand/FXReplayLogo.svg';

/**
 * Stays at the top of the screen, so the call to action is one tap away from anywhere on
 * the page. It is an outline button: the filled one belongs to the hero and the form.
 */
---

<header class="site-header">
  <div class="shell bar">
    <a class="home" href="#top" aria-label="FX Replay, candidate demo: top of the page">
      <img src={wordmark.src} width={wordmark.width} height={wordmark.height} alt="FX Replay" />
    </a>
    <p>
      <span class="narrow">Demo</span>
      <span class="wide">Candidate challenge demo. Not the official FX Replay site</span>
    </p>
    <a class="cta" href="#signup" data-cta="header">
      Start for free
    </a>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 10;
    border-bottom: 1px solid var(--border-primary);
    background: color-mix(in srgb, var(--bg-primary) 92%, transparent);
    backdrop-filter: blur(12px);
  }

  /* Three items in one row. The notice is the one that gives way: it shrinks, and below
     the widths where even its short form fits, it leaves the bar to the footer's copy. */
  .bar {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    min-height: var(--header-height);
  }

  /* A target as tall as the button beside it, around a wordmark that is not. */
  .home {
    display: flex;
    flex: none;
    align-items: center;
    min-height: 2.75rem;
    border-radius: 0.25rem;
  }

  /* The wordmark as shipped: scaled as a whole, never recolored. */
  img {
    width: auto;
    height: 1.125rem;
  }

  p {
    flex: 1;
    min-width: 0;
    overflow: hidden;
    color: var(--text-secondary);
    line-height: 1.3;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .cta {
    display: inline-flex;
    flex: none;
    align-items: center;
    min-height: 2.75rem;
    padding-inline: var(--space-4);
    border: 1px solid var(--border-field);
    border-radius: var(--radius-control);
    color: var(--text-primary);
    font-weight: 700;
    text-decoration: none;
    white-space: nowrap;
    transition:
      border-color 0.15s ease,
      background-color 0.15s ease;
  }

  @media (hover: hover) {
    .cta:hover {
      border-color: var(--icon-primary);
      background: var(--bg-tertiary);
    }
  }

  /* A tap gets an answer too: a phone has no hover. */
  .cta:active {
    border-color: var(--icon-primary);
    background: var(--bg-tertiary);
  }

  .wide {
    display: none;
  }

  /* The narrowest phones: a tighter row, and under 360px the bar is the wordmark and the
     call to action. The page still says what it is in the FAQ and the footer. */
  @media (width < 24rem) {
    .bar {
      gap: var(--space-2);
    }

    img {
      height: 1rem;
    }

    .cta {
      padding-inline: var(--space-3);
    }
  }

  @media (width < 22.5rem) {
    p {
      display: none;
    }

    .bar {
      justify-content: space-between;
    }
  }

  @media (width >= 48rem) {
    img {
      height: 1.375rem;
    }

    .bar {
      gap: var(--space-5);
    }

    p {
      text-align: right;
    }
  }

  /* The whole sentence only where the column holds it beside the other two. */
  @media (width >= 62rem) {
    .narrow {
      display: none;
    }

    .wide {
      display: inline;
    }
  }
</style>
