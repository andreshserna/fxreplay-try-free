---
import Signup from '../signup/Signup.astro';

const promises = ['Free plan', 'No credit card', 'No time limit'];
---

<section id="signup" class="shell closing" aria-labelledby="signup-heading">
  <div class="panel">
    <div class="ask">
      <p class="kicker">Try FX Replay free</p>
      <h2 id="signup-heading">Your first replay session is one email away.</h2>
    </div>
    <Signup location="closing" cta="Start for free" promises={promises} />
  </div>
</section>

<style>
  .closing {
    padding-block: var(--section);
    scroll-margin-top: var(--space-5);
  }

  .panel {
    display: grid;
    gap: var(--space-5);
    padding: clamp(1.5rem, 0.6rem + 4vw, 4rem);
    border: 1px solid var(--border-secondary);
    border-radius: var(--radius-surface);
    background:
      radial-gradient(
        120% 140% at 15% 0%,
        color-mix(in srgb, var(--chart-up) 16%, transparent),
        transparent 55%
      ),
      var(--bg-secondary);
  }

  .ask {
    display: grid;
    gap: var(--space-4);
  }

  h2 {
    max-width: 18ch;
    font-size: var(--step-3);
  }

  /* The same two columns as the plan and the questions above it. */
  @media (width >= 62rem) {
    .panel {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      gap: var(--space-8);
      align-items: center;
    }
  }

  /* Once the account exists, the heading that asked for it steps aside. */
  .panel:has(:global(.signup-after)) .ask {
    display: none;
  }

  .panel:has(:global(.signup-after)) {
    grid-template-columns: minmax(0, 1fr);
  }
</style>
