---
/**
 * An original illustration of market replay: candles already played, candles
 * arriving one by one behind a playhead, an open simulated trade, and a future
 * that stays hidden until the visitor plays it. It carries no ticker, prices or
 * dates, so it claims nothing about a market.
 *
 * The controls work: play, one candle at a time, and speed. A drawn play button
 * that does nothing is the first thing a visitor taps. Played to its end, the
 * trade is still open and back at its entry: the picture never shows a result.
 */
/**
 * The geometry is fixed, not passed in: the stylesheet below repeats two of these
 * numbers (the playhead's travel and its number of steps), because the page's Content
 * Security Policy allows no `style` attribute to carry them.
 */
const SHOWN = 21;
const REPLAYED = 6;
const SLOTS = 38;
const ENTRY = 19;
const SEED = 2682;
/** The candles behind the hatch: a continuation that touches neither level of the trade. */
const AHEAD_SEED = 292;

interface Candle {
  open: number;
  close: number;
  high: number;
  low: number;
}

/** A fixed pseudo-random walk, so every build draws the same chart. */
function series(count: number, start: number, from = 0, firstOpen = 50): Candle[] {
  let state = start;
  const random = () => {
    state = (state * 1664525 + 1013904223) % 4294967296;
    return state / 4294967296;
  };
  const candles: Candle[] = [];
  let price = firstOpen;
  for (let index = from; index < from + count; index += 1) {
    const drift = Math.sin(index / 3.4 + 0.8) * 2.6 + 0.5;
    const open = price;
    const close = open + drift + (random() - 0.5) * 9;
    candles.push({
      open,
      close,
      high: Math.max(open, close) + 0.8 + random() * 3.6,
      low: Math.min(open, close) - 0.8 - random() * 3.6,
    });
    price = close;
  }
  return candles;
}

const WIDTH = 760;
const HEIGHT = 440;
const PAD_TOP = 40;
const PAD_BOTTOM = 34;
const pitch = WIDTH / SLOTS; // 20: the playhead travels REPLAYED x 20 = 120
const bodyWidth = Math.round(pitch * 0.54);

const visible = series(SHOWN + REPLAYED, SEED);
const ahead = series(
  SLOTS - visible.length,
  AHEAD_SEED,
  visible.length,
  visible.at(-1)?.close ?? 50,
);
const sinceEntry = visible.slice(ENTRY);
const entryPrice = visible[ENTRY]?.close ?? 50;

// The trade is still open at the last candle: neither level has been reached. The levels
// come from what is shown at rest, and the candles ahead were chosen to stay between them.
const stop = Math.min(...sinceEntry.map((candle) => candle.low)) - 3;
const reach = Math.max(...sinceEntry.map((candle) => candle.high)) - entryPrice;
const target = entryPrice + Math.max(reach + 3, (entryPrice - stop) * 1.5);

// The picture never shows a result. The levels are computed from the candles shown, so
// those cannot reach them. The candles ahead come from a second seed: a change to the walk
// that lets one of them touch a level fails the build instead.
if (ahead.some((c) => c.high >= target || c.low <= stop)) {
  throw new Error('ReplayChart: a candle reaches the target or the stop of the drawn trade.');
}

const top = Math.max(target, ...visible.map((candle) => candle.high));
const bottom = Math.min(stop, ...visible.map((candle) => candle.low));
/** A tenth of a unit is finer than a screen draws, and fifteen decimals are bytes. */
const tenth = (value: number) => Math.round(value * 10) / 10;
const y = (price: number) =>
  tenth(PAD_TOP + ((top - price) / (top - bottom)) * (HEIGHT - PAD_TOP - PAD_BOTTOM));

const candles = [...visible, ...ahead].map((candle, index) => {
  const center = pitch * index + pitch / 2;
  const bodyTop = y(Math.max(candle.open, candle.close));
  const bodyBottom = y(Math.min(candle.open, candle.close));
  return {
    center,
    wickTop: y(candle.high),
    wickBottom: y(candle.low),
    bodyX: center - bodyWidth / 2,
    bodyY: bodyTop,
    bodyHeight: tenth(Math.max(bodyBottom - bodyTop, 4)),
    rising: candle.close >= candle.open,
    step: index - SHOWN,
  };
});

const playheadStart = pitch * SHOWN;
const tradeX = pitch * ENTRY + pitch / 2;
const gridLines = [0.2, 0.4, 0.6, 0.8].map((share) => Math.round(HEIGHT * share));
---

<figure
  class="replay"
  data-replay
  data-shown={SHOWN}
  data-resting={SHOWN + REPLAYED}
  data-slots={SLOTS}
>
  <svg
    viewBox={`0 0 ${WIDTH} ${HEIGHT}`}
    role="img"
    aria-label="Illustration: a candle chart replayed one candle at a time, with a simulated trade still open. Everything to the right of the playhead stays hidden until it is played."
  >
    <defs>
      <pattern id="future" width="10" height="10" patternUnits="userSpaceOnUse">
        <path d="M-2 12 12 -2" class="hatch"></path>
      </pattern>
    </defs>

    {gridLines.map((line) => (
      <path class="grid" d={`M0 ${line}H${WIDTH}`} />
    ))}

    <g class="trade">
      <rect
        class="target"
        x={tradeX}
        y={y(target)}
        width={WIDTH - tradeX}
        height={y(entryPrice) - y(target)}
      ></rect>
      <rect
        class="stop"
        x={tradeX}
        y={y(entryPrice)}
        width={WIDTH - tradeX}
        height={y(stop) - y(entryPrice)}
      ></rect>
      <path class="entry" d={`M${tradeX} ${y(entryPrice)}H${WIDTH}`}></path>
      <circle class="marker" cx={tradeX} cy={y(entryPrice)} r="5"></circle>
    </g>

    {candles.map((candle) => (
      <g
        class:list={[
          'candle',
          candle.rising ? 'rising' : 'falling',
          candle.step >= 0 && candle.step < REPLAYED && `arriving step-${candle.step}`,
          candle.step >= REPLAYED && 'ahead',
        ]}
      >
        <path class="wick" d={`M${candle.center} ${candle.wickTop}V${candle.wickBottom}`} />
        <rect
          class="body"
          x={candle.bodyX}
          y={candle.bodyY}
          width={bodyWidth}
          height={candle.bodyHeight}
          rx="3"
        />
      </g>
    ))}

    {/* Drawn from the playhead's first position and moved with it, so it always hides what is ahead. */}
    <rect class="future" x={playheadStart} y="0" width={WIDTH} height={HEIGHT}></rect>

    <g class="playhead">
      <path class="line" d={`M${playheadStart} 0V${HEIGHT}`}></path>
      <path class="handle" d={`M${playheadStart - 7} 0h14v9l-7 7-7-7z`}></path>
    </g>
  </svg>

  {/* Inert until the script below takes over: without it these would be buttons that do nothing. */}
  <div class="transport" role="group" aria-label="Controls of the replay illustration" inert>
    <button type="button" class="key play" data-control="play" aria-label="Play">
      <svg class="icon-play" viewBox="0 0 16 16" width="16" height="16" aria-hidden="true">
        <path d="M4.5 2.5v11l9-5.5z"></path>
      </svg>
      <svg class="icon-pause" viewBox="0 0 16 16" width="16" height="16" aria-hidden="true">
        <path d="M3.5 2.5h3.5v11H3.5zM9 2.5h3.5v11H9z"></path>
      </svg>
    </button>
    <button type="button" class="key" data-control="step" aria-label="Next candle">
      <svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true">
        <path d="M11 3h2v10h-2zM3 3v10l7-5z"></path>
      </svg>
    </button>
    <span class="track">
      <span class="played"></span>
    </span>
    <button type="button" class="key speed" data-control="speed" aria-label="Speed: 1x">
      1x
    </button>
  </div>
</figure>

<script>
  /** The time one candle takes at 1x, and the speeds the last control cycles through. */
  const TICK_MS = 600;
  const SPEEDS = [1, 2, 4];

  for (const figure of document.querySelectorAll<HTMLElement>('[data-replay]')) {
    const shown = Number(figure.dataset.shown);
    const slots = Number(figure.dataset.slots);
    const candles = [...figure.querySelectorAll('.candle')];
    const chart = figure.querySelector('svg');
    const transport = figure.querySelector('.transport');
    const playKey = figure.querySelector<HTMLButtonElement>('[data-control="play"]');
    const speedKey = figure.querySelector<HTMLButtonElement>('[data-control="speed"]');
    if (!chart || !transport || !playKey || !speedKey) continue;

    let position = Number(figure.dataset.resting);
    let speed = 0;
    let timer: number | undefined;
    let used = false;

    const render = () => {
      // From here the script places the playhead. The entrance animation steps aside.
      figure.classList.add('live');
      figure.style.setProperty('--at', String(position - shown));
      candles.forEach((candle, index) => candle.classList.toggle('ahead', index >= position));
      const playing = timer !== undefined;
      figure.dataset.state = playing ? 'playing' : 'paused';
      playKey.setAttribute(
        'aria-label',
        playing ? 'Pause' : position >= slots ? 'Play again' : 'Play',
      );
      speedKey.textContent = `${SPEEDS[speed]}x`;
      speedKey.setAttribute('aria-label', `Speed: ${SPEEDS[speed]}x`);
    };

    const pause = () => {
      window.clearInterval(timer);
      timer = undefined;
    };

    const step = () => {
      // Past the last candle, the replay starts over.
      if (position >= slots) position = shown;
      position += 1;
      if (position >= slots) pause();
      render();
    };

    const start = () => {
      timer = window.setInterval(step, TICK_MS / (SPEEDS[speed] ?? 1));
    };

    const controls: Record<string, () => void> = {
      play: () => {
        if (timer === undefined) {
          start();
          step(); // The first candle arrives on the tap, not a beat later.
        } else {
          pause();
          render();
        }
      },
      step: () => {
        pause();
        step();
      },
      speed: () => {
        speed = (speed + 1) % SPEEDS.length;
        if (timer !== undefined) {
          pause();
          start();
        }
        render();
      },
    };

    const use = (control: 'play' | 'step' | 'speed') => {
      controls[control]?.();
      if (used) return;
      used = true;
      // Asked for when it is needed: the controls must work even if the tracker's file
      // never arrives.
      void import('../../lib/analytics/track')
        .then(({ track }) => track('replay_demo_used', { control }))
        .catch(() => undefined);
    };

    transport.addEventListener('click', (event) => {
      const key = event.target instanceof Element ? event.target.closest('button') : null;
      const control = key?.dataset.control;
      if (control === 'play' || control === 'step' || control === 'speed') use(control);
    });
    // The chart itself is the other thing a visitor taps.
    chart.addEventListener('click', () => use('play'));
    document.addEventListener('visibilitychange', () => {
      if (document.visibilityState === 'hidden' && timer !== undefined) {
        pause();
        render();
      }
    });
    transport.removeAttribute('inert');
    figure.classList.add('ready');
  }
</script>

<style>
  .replay {
    margin: 0;
    overflow: hidden;
    border: 1px solid var(--border-primary);
    border-radius: var(--radius-surface);
    background:
      radial-gradient(
        120% 140% at 15% 0%,
        color-mix(in srgb, var(--chart-up) 16%, transparent),
        transparent 55%
      ),
      var(--bg-secondary);
  }

  svg {
    width: 100%;
    height: auto;
  }

  .grid {
    stroke: var(--chart-grid);
    stroke-width: 1;
  }

  .hatch {
    stroke: var(--chart-future);
    stroke-width: 1;
  }

  .future {
    fill: url('#future');
    /* At rest: REPLAYED x pitch past the playhead's first position. */
    transform: translateX(120px);
  }

  /* A candle the replay has not reached yet. */
  .ahead {
    opacity: 0;
  }

  /* Once a control is used, the script sets --at: candles past the first position, 20px each. */
  .live .playhead,
  .live .future {
    transform: translateX(calc(var(--at) * 20px));
    transition: transform 0.2s ease-out;
    animation: none;
  }

  .live .candle {
    transition: opacity 0.2s ease-out;
    animation: none;
  }

  .ready svg {
    cursor: pointer;
  }

  .target {
    fill: color-mix(in srgb, var(--chart-up) 20%, transparent);
  }

  .stop {
    fill: color-mix(in srgb, var(--chart-down) 12%, transparent);
  }

  .entry {
    stroke: var(--icon-primary);
    stroke-width: 1;
    stroke-dasharray: 2 5;
  }

  .marker {
    fill: var(--bg-secondary);
    stroke: var(--icon-primary);
    stroke-width: 2;
  }

  .wick {
    stroke-width: 2;
    stroke-linecap: round;
  }

  .rising .wick {
    stroke: var(--chart-up);
  }

  .rising .body {
    fill: var(--chart-up);
  }

  .falling .wick {
    stroke: var(--chart-down);
  }

  .falling .body {
    fill: var(--chart-down);
  }

  .playhead .line {
    stroke: var(--chart-playhead);
    stroke-width: 1.5;
  }

  .playhead .handle {
    fill: var(--chart-playhead);
  }

  /* The replay: the playhead steps right and each candle appears as it passes. */
  .playhead {
    /* REPLAYED steps of 0.6s each, over REPLAYED x pitch = 120 units. */
    animation: advance 3.6s steps(6) 1s both;
  }

  .arriving {
    animation: arrive 0.2s ease-out both;
  }

  /* Each candle appears as the playhead passes it: 1s + step x 0.6s + 0.55s. */
  .step-0 {
    animation-delay: 1.55s;
  }

  .step-1 {
    animation-delay: 2.15s;
  }

  .step-2 {
    animation-delay: 2.75s;
  }

  .step-3 {
    animation-delay: 3.35s;
  }

  .step-4 {
    animation-delay: 3.95s;
  }

  .step-5 {
    animation-delay: 4.55s;
  }

  @keyframes advance {
    to {
      transform: translateX(120px);
    }
  }

  @keyframes arrive {
    from {
      opacity: 0;
    }
  }

  .transport {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    padding: var(--space-3) var(--replay-bleed, var(--space-4)) var(--space-3) var(--space-4);
    border-top: 1px solid var(--border-primary);
  }

  .key {
    display: grid;
    flex: none;
    place-items: center;
    min-width: 2.75rem;
    height: 2.75rem;
    padding: 0;
    border: 1px solid var(--border-field);
    border-radius: var(--radius-control);
    background: none;
    color: var(--text-primary);
    font: inherit;
    cursor: pointer;
    transition:
      border-color 0.15s ease,
      background-color 0.15s ease,
      transform 0.1s ease;
  }

  .key svg {
    width: 1rem;
    fill: var(--icon-primary);
  }

  .key.play {
    border-color: var(--chart-playhead);
  }

  .key.play svg {
    fill: var(--chart-playhead);
  }

  @media (hover: hover) {
    .key:hover {
      border-color: var(--icon-primary);
      background: var(--bg-tertiary);
    }
  }

  .key:active {
    transform: scale(0.94);
  }

  .icon-pause,
  [data-state='playing'] .icon-play {
    display: none;
  }

  [data-state='playing'] .icon-pause {
    display: block;
  }

  .track {
    flex: 1;
    height: 0.25rem;
    overflow: hidden;
    border-radius: 1rem;
    background: var(--border-secondary);
  }

  .played {
    display: block;
    height: 100%;
    border-radius: inherit;
    background: var(--chart-up);
    width: 71%; /* (SHOWN + REPLAYED) / SLOTS */
  }

  .live .played {
    width: calc((var(--at) + 21) / 38 * 100%);
    transition: width 0.2s ease-out;
  }

  /* A label on a control, not a line of text: it is pressed, not selected. */
  .speed {
    padding-inline: var(--space-3);
    font-size: 1rem;
    font-weight: 700;
    font-variant-numeric: tabular-nums;
    user-select: none;
  }
</style>
