{
  "name": "fxreplay-try-free",
  "version": "0.0.0",
  "private": true,
  "description": "Candidate challenge demo: a 'Try FX Replay Free' landing page, signup flow and Users API. Not the official FX Replay site.",
  "type": "module",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "setup": "node scripts/dev/setup.mjs",
    "predev": "npm run --silent setup",
    "dev": "astro dev",
    "build": "astro build",
    "prepreview": "npm run --silent setup",
    "preview": "astro preview",
    "types": "wrangler types",
    "typecheck": "wrangler types && astro check",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:api": "vitest run --config vitest.api.config.ts",
    "gen": "node scripts/gen/tokens-css.mjs && node scripts/checks/contrast.mjs --write-docs && node scripts/gen/analytics-docs.mjs",
    "gen:check": "node scripts/gen/tokens-css.mjs --check && node scripts/checks/contrast.mjs --check-docs && node scripts/gen/analytics-docs.mjs --check",
    "check:tokens": "node scripts/checks/token-usage.mjs",
    "check:contrast": "node scripts/checks/contrast.mjs",
    "check:kit": "node scripts/kit/tokens-from-kit.mjs",
    "test:system": "node --test \"scripts/**/*.test.mjs\" \".claude/hooks/*.test.mjs\""
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.4.9",
    "@astrojs/react": "^7.1.9",
    "astro": "^7.4.13",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@eslint/js": "^10.0.1",
    "@fontsource/lato": "^5.3.0",
    "@fontsource/nunito-sans": "^5.3.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^10.15.0",
    "eslint-plugin-astro": "^3.2.1",
    "eslint-plugin-jsx-a11y-x": "^0.2.0",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "prettier-plugin-astro": "^1.1.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0",
    "vitest": "^5.1.1",
    "wrangler": "^4.165.0"
  }
}
